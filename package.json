{
  "name": "quan-bar-dem",
  "version": "1.0.0",
  "private": true,
  "description": "Website quản lý quán bar - Đồ án cuối khoá JavaScript (HTML + CSS + JavaScript thuần ES6+, dữ liệu qua json-server)",
  "type": "module",
  "scripts": {
    "start": "json-server db.json --static . --port 3000",
    "api": "json-server db.json --port 3000",
    "web": "node tools/server.js",
    "seed": "node tools/tao-db.js",
    "images": "node tools/tao-anh.js",
    "check": "node tools/kiem-tra-module.js",
    "test": "node tools/kiem-tra-ton-kho.js && node tools/test-chatbot.js",
    "health": "node tools/kiem-tra-toan-dien.js",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js js tools"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "json-server": "0.17.4"
  }
}
